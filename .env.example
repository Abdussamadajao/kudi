# Copy to `.env` and fill in values. Never commit `.env`.

# API (Expo app — must be EXPO_PUBLIC_* for client bundle)
EXPO_PUBLIC_API_BASE_URL=

# Cloudinary (receipt / avatar uploads)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Server / Prisma (not used in the Expo client bundle)
# DATABASE_URL=
